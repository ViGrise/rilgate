# Generate a secret with: openssl rand -hex 32
# Supply the value through your environment or an untracked .env file.
RILGATE_SECRET=
RILGATE_UPSTREAM_URL=http://127.0.0.1:3000
# RILGATE_LISTEN=127.0.0.1:8080
# RILGATE_CONFIG=/etc/rilgate/config.yml

# Other settings use YAML; values can reference ${VARIABLE_NAME}.
# Per-request diagnostics are DEBUG; raise the filter when needed.
RUST_LOG=rilgate=info
