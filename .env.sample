ENV=development
SERVE_PORT=8080

WEB_NAME=Rilgate
WEB_WEBSITE_URL=https://rilgate.com
WEB_BASE_PATH=/.well-known/rilgate
WEB_STYLESHEET_PATH=css/rilgate.css
# WEB_ROOT=/etc/rilgate/web
WEB_SEED_EMPTY_DIRECTORY=true
WEB_WATCH_ENABLED=false
WEB_WATCH_DEBOUNCE=300ms
WEB_TEMPLATES_CACHE=true
WEB_TEMPLATES_STRICT=true
WEB_TEMPLATES_RECURSION_LIMIT=64
WEB_TEMPLATES_FUEL=50000
WEB_I18N_DEFAULT_LOCALE=en
WEB_I18N_SUPPORTED_LOCALES=en
WEB_I18N_STRICT=false
WEB_I18N_LANGUAGE_COOKIE_NAME=rilgate_lang

UPSTREAM_URL=http://127.0.0.1:3000

POW_ENFORCE=local_verify
POW_SIGNING_KEY=change-me-pow-signing-key
POW_AUTH_SIGNING_KEY=change-me-auth-signing-key
POW_AUTH_COOKIE_NAME=rilgate_auth

POW_P2POOL_HOST=127.0.0.1
POW_P2POOL_PORT=3333

RUST_LOG=rilgate=debug,tower_http=info
