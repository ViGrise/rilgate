# Rilgate environment configuration
#
# Each variable sets the YAML setting named in its comment and overrides the
# configuration file; command-line flags override variables. A variable that is
# unset keeps the YAML value or its default. Variable names follow the YAML path:
# server.upstream.url is RILGATE_SERVER_UPSTREAM_URL and --server-upstream-url.
#
# Values use the same syntax as YAML values. Durations use units such as 300ms,
# 5s, 1m and 6h; sizes use 1024B, 1KiB, 16MiB and 1GiB; booleans are true or
# false; lists are comma-separated and replace the YAML list, and an empty value
# clears it. Invalid values fail validation and name their variable.
#
# Copy this file to .env in the working directory, or pass --env-file FILE.
# Variables already set in the process environment take precedence over the
# file. Policy rules, IP sets and signing key rotation are configured in YAML.
# Optional variables are commented out; values shown are defaults.
#
# Check the result: rilgate config check
# Inspect resolved values: rilgate config show --defaults

################################### PROCESS ###################################

# YAML configuration file. An explicitly selected missing file fails; a
# missing default file is allowed when variables supply the required values.
# Flag: --config
#
# RILGATE_CONFIG=config/rilgate.yml

# Replaces only the port of the resolved listen address. Flag: --port
#
# RILGATE_PORT=

# Log filter. Per-request diagnostics are DEBUG; raise the filter when needed.
# Flag: --log-level
#
# RUST_LOG=rilgate=info,pingora=error

# Log output: text or json. Flag: --log-format
#
# RILGATE_LOG_FORMAT=text

################################# ENVIRONMENT #################################

# production: Secure authentication cookies and no client-controlled score header.
# Serve production traffic through HTTPS, normally at a trusted reverse proxy.
# development: permits local HTTP cookies and the optional score debug header.
# Signing keys must meet the same strength requirements in either environment.
# YAML: environment. Flag: --environment
#
# RILGATE_ENVIRONMENT=production

################################### SERVER ####################################

# Bind address. ':8080' listens on all IPv4 interfaces.
# Use '127.0.0.1:8080' behind a local edge or '[::]:8080' for IPv6.
# Hostnames are not supported here; use an IP address and port.
# YAML: server.listen. Flag: --server-listen
#
# RILGATE_SERVER_LISTEN=:8080

# REQUIRED. HTTP or HTTPS application URL, optionally including a base path.
# Credentials, query strings and fragments are forbidden. No default URL.
# YAML: server.upstream.url. Flag: --server-upstream-url
#
RILGATE_SERVER_UPSTREAM_URL=http://127.0.0.1:3000

# Forward the incoming Host header. Set false to use the upstream authority.
# HTTPS certificate verification still uses the configured upstream hostname.
# YAML: server.upstream.preserve_host. Flag: --server-upstream-preserve-host
#
# RILGATE_SERVER_UPSTREAM_PRESERVE_HOST=true

# Maximum incoming proxied body size. Upstream responses remain streamed.
# Oversized requests receive 413. With an unknown-length streaming body,
# earlier bytes may already have reached the upstream before the limit is hit.
# YAML: server.upstream.max_body_size. Flag: --server-upstream-max-body-size
#
# RILGATE_SERVER_UPSTREAM_MAX_BODY_SIZE=16MiB

# Per-attempt upstream connection timeout, within the overall connection
# budget of 30s. DNS resolution and connection setup consume that budget.
# YAML: server.upstream.timeout.connect. Flag: --server-upstream-timeout-connect
#
# RILGATE_SERVER_UPSTREAM_TIMEOUT_CONNECT=5s

# Upstream read/write inactivity timeout, not a total response lifetime.
# A timeout before response headers returns 504; during a response it
# terminates the stream, since headers have already been sent.
# YAML: server.upstream.timeout.read. Flag: --server-upstream-timeout-read
#
# RILGATE_SERVER_UPSTREAM_TIMEOUT_READ=30s

# Maximum accepted TCP connections, including idle connections. Range: 1..1000000.
# Excess connections are closed before request processing.
# YAML: server.max_connections. Flag: --server-max-connections
#
# RILGATE_SERVER_MAX_CONNECTIONS=1024

# Maximum concurrent requests. Streaming responses and upgraded WebSockets hold
# their slot until completion. Excess requests receive 503 with Retry-After.
# Range: 1..1000000. This is independent of the TCP connection limit.
# YAML: server.max_requests. Flag: --server-max-requests
#
# RILGATE_SERVER_MAX_REQUESTS=512

# Maximum concurrent HTTP/2 streams advertised per connection. Range: 1..1024.
# The process-wide max_requests limit also applies across all connections.
# YAML: server.h2_max_streams. Flag: --server-h2-max-streams
#
# RILGATE_SERVER_H2_MAX_STREAMS=64

# Trusted immediate proxy peers, as IPv4/IPv6 CIDRs; at most 64 networks.
# Empty means no peer can supply the client IP through X-Forwarded-For.
# For a trusted peer, the chain is read right-to-left to the nearest untrusted
# hop. The resolved IP drives both policy matching and per-client proof quotas.
# Trust only actual edge proxies, which must overwrite incoming forwarding data.
# Example: ["127.0.0.1/32", "::1/128"]. Forwarded is not used for client identity.
# YAML: server.trusted_proxies. Flag: --server-trusted-proxies
#
# RILGATE_SERVER_TRUSTED_PROXIES=

# Enable Prometheus metrics at <site.base_path>/api/metrics; false returns 404.
# This endpoint has no application authentication. Restrict access at the edge.
# Labels are bounded; request paths and client identities are not metric labels.
# YAML: server.metrics_enabled. Flag: --server-metrics-enabled
#
# RILGATE_SERVER_METRICS_ENABLED=false

# Dependency-probe timeout for <site.base_path>/api/ready. Maximum: 30s.
# Readiness probes TCP reachability of the upstream and, when required by the
# selected challenges, P2Pool. This does not check application response health.
# <site.base_path>/api/live only reports process liveness.
# YAML: server.readiness_timeout. Flag: --server-readiness-timeout
#
# RILGATE_SERVER_READINESS_TIMEOUT=2s

#################################### SITE #####################################

# Display name used by challenge pages. Control characters are forbidden.
# YAML: site.name. Flag: --site-name
#
# RILGATE_SITE_NAME=Rilgate

# Public site/branding URL, not the upstream. HTTP/HTTPS without credentials.
# YAML: site.url. Flag: --site-url
#
# RILGATE_SITE_URL=https://rilgate.com

# Reserved prefix for proof APIs and assets. Use an absolute, non-root path
# without a trailing slash, dot segments, query or fragment. Internal routing
# runs before user policies; unknown internal routes return 404.
# YAML: site.base_path. Flag: --site-base-path
#
# RILGATE_SITE_BASE_PATH=/.well-known/rilgate

# Logical stylesheet path under the static resource tree, not an external URL.
# The bundled default resolves to static/css/rilgate.css.
# YAML: site.stylesheet. Flag: --site-stylesheet
#
# RILGATE_SITE_STYLESHEET=css/rilgate.css

# Example override directory, not a default. Omitted means embedded-only.
# External templates/, static/ and i18n/ overlay embedded resources.
# Relative directories resolve from the process working directory.
# Symlinks are rejected. Startup can fall back to embedded resources when
# overrides are invalid; use 'rilgate ... web validate' to check them.
# YAML: site.resources.directory. Flag: --site-resources-directory
#
# RILGATE_SITE_RESOURCES_DIRECTORY=

# if_empty seeds embedded files only into an empty external directory.
# Hidden files make it nonempty; existing contents are never overwritten.
# never disables seeding. No directory means there is nothing to seed.
# YAML: site.resources.seed. Flag: --site-resources-seed
#
# RILGATE_SITE_RESOURCES_SEED=if_empty

# Watch external files and atomically publish valid resource snapshots.
# Invalid reloads retain the previous snapshot. Embedded-only mode has
# no watcher. On Unix, SIGHUP can also trigger a resource reload.
# YAML: site.resources.watch.enabled. Flag: --site-resources-watch-enabled
#
# RILGATE_SITE_RESOURCES_WATCH_ENABLED=false

# Coalesce nearby filesystem events. Must be positive and at most 60s.
# YAML: site.resources.watch.debounce. Flag: --site-resources-watch-debounce
#
# RILGATE_SITE_RESOURCES_WATCH_DEBOUNCE=300ms

# In-memory compiled template cache. Currently must be true; false is
# unsupported. This does not enable browser caching of challenge responses.
# YAML: site.templates.cache. Flag: --site-templates-cache
#
# RILGATE_SITE_TEMPLATES_CACHE=true

# Undefined template variables produce errors instead of empty output.
# YAML: site.templates.strict. Flag: --site-templates-strict
#
# RILGATE_SITE_TEMPLATES_STRICT=true

# Maximum nested template recursion, including includes. Range: 1..256.
# YAML: site.templates.recursion_limit. Flag: --site-templates-recursion-limit
#
# RILGATE_SITE_TEMPLATES_RECURSION_LIMIT=64

# Positive instruction budget per template evaluation, bounding rendering
# work such as loops. Increase only for trusted, more complex templates.
# YAML: site.templates.fuel. Flag: --site-templates-fuel
#
# RILGATE_SITE_TEMPLATES_FUEL=50000

# auto, html or json. html keeps browser pages and plain 401 for unsafe methods;
# json always uses the JSON templates for challenge and denial responses.
# YAML: site.responses.format. Flag: --site-responses-format
#
# RILGATE_SITE_RESPONSES_FORMAT=auto

# Optional API path prefixes that always receive JSON in auto mode, even if
# a client sends Accept: text/html. Matches whole path segments: /api matches
# /api and /api/users, but not /apiary. Up to 64 absolute paths; no escapes,
# query, fragment or dot segments. Cannot be combined with format: html.
# Example: [/api, /graphql]. Empty means use request headers only.
# YAML: site.responses.json_paths. Flag: --site-responses-json-paths
#
# RILGATE_SITE_RESPONSES_JSON_PATHS=

# Default/fallback BCP 47 locale tag. Must be included in supported when an
# explicit supported list is supplied, and available in loaded resources.
# YAML: site.i18n.default. Flag: --site-i18n-default
#
# RILGATE_SITE_I18N_DEFAULT=en

# Empty or omitted discovers locales from translation files. A nonempty
# list restricts offered locales, for example [en, vi].
# YAML: site.i18n.supported. Flag: --site-i18n-supported
#
# RILGATE_SITE_I18N_SUPPORTED=

# Treat missing translation keys as validation errors. With false, missing
# keys are reported while locale/default/English fallback remains available.
# YAML: site.i18n.strict. Flag: --site-i18n-strict
#
# RILGATE_SITE_I18N_STRICT=false

# Language preference cookie name, using valid HTTP token characters.
# Selection order: ?lang, language cookie, Accept-Language, default locale.
# YAML: site.i18n.cookie. Flag: --site-i18n-cookie
#
# RILGATE_SITE_I18N_COOKIE=rilgate_lang

################################## SECURITY ###################################

# REQUIRED in single-secret mode. Supply at least 32 bytes of high-entropy data.
# HKDF-SHA256 derives independent challenge and authentication signing keys.
# Keep the secret outside source control. Changing it invalidates existing
# signatures. Instances sharing this secret and compatible verification settings
# can verify each other's local proofs and authentication tokens.
# YAML: security.secret. Flag: --security-secret
#
RILGATE_SECURITY_SECRET=

# Cookie name, using valid HTTP token characters. Cookies are host-scoped,
# HttpOnly and SameSite=Lax, with Secure enabled in production.
# YAML: security.auth.cookie. Flag: --security-auth-cookie
#
# RILGATE_SECURITY_AUTH_COOKIE=rilgate_auth

# Access lifetime, anchored to receipt issuance; repeated receipt exchange
# cannot extend it. Positive whole seconds, at most 365d.
# A valid cookie still cannot bypass a deny rule or a stronger challenge.
# YAML: security.auth.ttl. Flag: --security-auth-ttl
#
# RILGATE_SECURITY_AUTH_TTL=6h

# Leading IPv4 bits that must match. 0 to 32; 24 binds the /24 network.
# Setting this or ipv6_prefix enables IP binding.
# YAML: security.auth.bind.client_ip.ipv4_prefix. Flag: --security-auth-bind-client-ip-ipv4-prefix
#
# RILGATE_SECURITY_AUTH_BIND_CLIENT_IP_IPV4_PREFIX=24

# Leading IPv6 bits that must match. 0 to 128; 64 binds the /64 network.
# Setting this or ipv4_prefix enables IP binding.
# YAML: security.auth.bind.client_ip.ipv6_prefix. Flag: --security-auth-bind-client-ip-ipv6-prefix
#
# RILGATE_SECURITY_AUTH_BIND_CLIENT_IP_IPV6_PREFIX=64

# Bind to the User-Agent header. Absent means not bound. 'full' requires the
# exact value; 'family' ignores version numbers, so browser updates keep
# the cookie valid while a different browser needs a new solve.
# YAML: security.auth.bind.user_agent. Flag: --security-auth-bind-user-agent
#
# RILGATE_SECURITY_AUTH_BIND_USER_AGENT=

# Client request headers to bind, read on every request, at most 16 names.
# A missing header differs from an empty one. Example: [accept-language]
# YAML: security.auth.bind.headers. Flag: --security-auth-bind-headers
#
# RILGATE_SECURITY_AUTH_BIND_HEADERS=

# Headers set by an edge proxy, such as a JA4 TLS fingerprint, at most 16
# names. They are read only when the immediate TCP peer is inside
# server.trusted_proxies and are ignored from any other peer.
# Example: [x-ja4]
# YAML: security.auth.bind.proxy_headers. Flag: --security-auth-bind-proxy-headers
#
# RILGATE_SECURITY_AUTH_BIND_PROXY_HEADERS=

################################ PROOF OF WORK ################################

# local_verify checks Fast SHA-256 or RandomX proofs on this gateway.
# Compatible signed local proofs can be verified across instances.
# p2pool_accepted requires RandomX challenges and an actual accepted share
# response from P2Pool, through a retained WebSocket/Stratum session. HTTP
# RandomX issue/verify is unavailable in that mode. Route sessions back to
# their owning gateway; there is no distributed session store.
# YAML: pow.verification. Flag: --pow-verification
#
# RILGATE_POW_VERIFICATION=local_verify

# Algorithm when a challenge action omits algorithm: fast or randomx.
# Presets explicitly select fast. Selecting RandomX requires explicit P2Pool
# configuration for jobs, including when verification is local.
# YAML: pow.default_algorithm. Flag: --pow-default-algorithm
#
# RILGATE_POW_DEFAULT_ALGORITHM=fast

# Challenge presentation token and Fast work lifetime. Whole seconds only.
# YAML: pow.challenge.ttl. Flag: --pow-challenge-ttl
#
# RILGATE_POW_CHALLENGE_TTL=1m

# Window for exchanging a verified receipt for authentication. Whole seconds.
# YAML: pow.challenge.receipt_ttl. Flag: --pow-challenge-receipt-ttl
#
# RILGATE_POW_CHALLENGE_RECEIPT_TTL=30s

# Apply per-client and global token buckets to proof HTTP APIs and WebSocket
# handshakes. Ordinary proxied requests use server admission limits instead.
# Quotas are per gateway process, not shared across a deployment.
# YAML: pow.rate_limit.enabled. Flag: --pow-rate-limit-enabled
#
# RILGATE_POW_RATE_LIMIT_ENABLED=true

# Maximum tracked client-IP buckets, bounding memory. Range: 1..65536.
# If no bucket can be reclaimed at capacity, new clients are rate limited.
# YAML: pow.rate_limit.max_clients. Flag: --pow-rate-limit-max-clients
#
# RILGATE_POW_RATE_LIMIT_MAX_CLIENTS=4096

# Per-client initial token count and bucket capacity. Range: 1..1000000.
# YAML: pow.rate_limit.client.burst. Flag: --pow-rate-limit-client-burst
#
# RILGATE_POW_RATE_LIMIT_CLIENT_BURST=10

# Tokens restored per second; 0.1 means one token every 10 seconds.
# Must be finite and within 0.001..1000000.
# YAML: pow.rate_limit.client.refill_per_second. Flag: --pow-rate-limit-client-refill-per-second
#
# RILGATE_POW_RATE_LIMIT_CLIENT_REFILL_PER_SECOND=0.1

# Shared initial tokens and capacity across clients. Range: 1..1000000.
# YAML: pow.rate_limit.global.burst. Flag: --pow-rate-limit-global-burst
#
# RILGATE_POW_RATE_LIMIT_GLOBAL_BURST=64

# Process-wide replenishment rate. Finite, within 0.001..1000000.
# YAML: pow.rate_limit.global.refill_per_second. Flag: --pow-rate-limit-global-refill-per-second
#
# RILGATE_POW_RATE_LIMIT_GLOBAL_REFILL_PER_SECOND=16.0

# Signed RandomX work lifetime for local verification, separate from the
# shorter presentation-token TTL. Positive whole seconds, at most 365d.
# YAML: pow.algorithms.randomx.challenge_ttl. Flag: --pow-algorithms-randomx-challenge-ttl
#
# RILGATE_POW_ALGORITHMS_RANDOMX_CHALLENGE_TTL=1h

# Byte offset of the 4-byte nonce in the mining blob. Range: 0..252;
# it must also fit the actual P2Pool job blob. 39 is the Monero layout.
# YAML: pow.algorithms.randomx.nonce_offset. Flag: --pow-algorithms-randomx-nonce-offset
#
# RILGATE_POW_ALGORITHMS_RANDOMX_NONCE_OFFSET=39

# Pending native verification jobs, serviced by a dedicated worker.
# Range: 1..1024. A full queue returns 503 rather than growing unbounded.
# YAML: pow.algorithms.randomx.verifier_queue. Flag: --pow-algorithms-randomx-verifier-queue
#
# RILGATE_POW_ALGORITHMS_RANDOMX_VERIFIER_QUEUE=8

# Minimum automatic difficulty, at least 1000.
# YAML: pow.algorithms.randomx.difficulty.base. Flag: --pow-algorithms-randomx-difficulty-base
#
# RILGATE_POW_ALGORITHMS_RANDOMX_DIFFICULTY_BASE=1000

# Positive integer score interval per doubling. Automatic difficulty is
# base * 2^(score / score_step), with integer division and exponent
# clamped to 0..63, then capped at max. Negative scores do not reduce base.
# YAML: pow.algorithms.randomx.difficulty.score_step. Flag: --pow-algorithms-randomx-difficulty-score-step
#
# RILGATE_POW_ALGORITHMS_RANDOMX_DIFFICULTY_SCORE_STEP=10

# Maximum automatic difficulty, at least base. An explicit challenge
# difficulty bypasses this calculation/cap, but must still be >= 1000.
# YAML: pow.algorithms.randomx.difficulty.max. Flag: --pow-algorithms-randomx-difficulty-max
#
# RILGATE_POW_ALGORITHMS_RANDOMX_DIFFICULTY_MAX=32000

# Solver module under site.base_path, even with the leading '/'.
# Must be a local safe resource path, not an arbitrary external URL.
# YAML: pow.algorithms.randomx.browser.module. Flag: --pow-algorithms-randomx-browser-module
#
# RILGATE_POW_ALGORITHMS_RANDOMX_BROWSER_MODULE=/static/js/solvers/randomx/solver.js

################################### P2POOL ####################################

# Stratum host:port or [IPv6]:port. No URL scheme, credentials or path.
# YAML: pow.p2pool.address. Flag: --pow-p2pool-address
#
# RILGATE_POW_P2POOL_ADDRESS=127.0.0.1:3333

# Pool login password. 'x' is the default, not a Rilgate signing key.
# Use an environment reference if your pool requires a private credential.
# YAML: pow.p2pool.password. Flag: --pow-p2pool-password
#
# RILGATE_POW_P2POOL_PASSWORD=

# Client agent identifier sent in the Stratum login.
# YAML: pow.p2pool.agent. Flag: --pow-p2pool-agent
#
# RILGATE_POW_P2POOL_AGENT=rilgate/0.1.0

# Timeout for connection setup and initial login response.
# YAML: pow.p2pool.timeout.connect. Flag: --pow-p2pool-timeout-connect
#
# RILGATE_POW_P2POOL_TIMEOUT_CONNECT=5s

# Maximum wait for the pool response to a submitted share. A locally valid
# hash alone does not grant access with p2pool_accepted verification.
# YAML: pow.p2pool.timeout.submit. Flag: --pow-p2pool-timeout-submit
#
# RILGATE_POW_P2POOL_TIMEOUT_SUBMIT=20s

# Shared capacity for job connections and WebSocket verification sessions.
# Range: 1..4096; process-local. Capacity exhaustion returns 503.
# YAML: pow.p2pool.sessions.max. Flag: --pow-p2pool-sessions-max
#
# RILGATE_POW_P2POOL_SESSIONS_MAX=64

# Maximum lifetime of a WebSocket acceptance session, not a proof-token TTL.
# YAML: pow.p2pool.sessions.ttl. Flag: --pow-p2pool-sessions-ttl
#
# RILGATE_POW_P2POOL_SESSIONS_TTL=15m

# pooled reuses difficulty-specific job connections. per_challenge opens
# a connection per issued challenge. Both consume sessions.max capacity.
# YAML: pow.p2pool.job_sessions.mode. Flag: --pow-p2pool-job-sessions-mode
#
# RILGATE_POW_P2POOL_JOB_SESSIONS_MODE=pooled

# Maximum pooled job sessions, 1..4096 and <= sessions.max in pooled mode.
# Not used as a pool size in per_challenge mode; zero is never a mode switch.
# YAML: pow.p2pool.job_sessions.max. Flag: --pow-p2pool-job-sessions-max
#
# RILGATE_POW_P2POOL_JOB_SESSIONS_MAX=16

# Pooled connection idle timeout since the last job request. Incoming job
# notifications do not extend it. Not used in per_challenge mode.
# YAML: pow.p2pool.job_sessions.idle. Flag: --pow-p2pool-job-sessions-idle
#
# RILGATE_POW_P2POOL_JOB_SESSIONS_IDLE=1m

################################### POLICY ####################################

# off: allow application traffic without proof enforcement.
# light: challenge empty or bot-like user agents with Fast difficulty 1.
# balanced: challenge application traffic with Fast difficulty 2.
# strict: challenge application traffic with Fast difficulty 4.
# custom: use only the rules, score and default_action configured below.
# light/balanced/strict allow /robots.txt, /favicon.ico and ACME challenge paths.
# All presets use Fast and need no mining pool. Internal APIs/assets are
# dispatched before policies, including broad public /.well-known/ exceptions.
# YAML: policy.mode. Flag: --policy-mode
#
# RILGATE_POLICY_MODE=balanced
