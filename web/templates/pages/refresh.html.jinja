{% extends "layouts/base.html.jinja" %}
{% block head %}
<meta http-equiv="refresh" content="{{ challenge.difficulty }};url={{ challenge.url }}">
{% endblock %}
{% block content %}
<main>
  <h1 id="title">{{ t("refresh.title") }}</h1>
  <p id="description">{{ t("refresh.description") }}</p>
  <div id="bar" class="bar" aria-hidden="true"><span id="bar-shimmer" class="bar-shimmer"></span><span id="bar-complete" class="bar-complete"></span></div>
  <p id="status" role="status">{{ t("refresh.waiting", seconds=challenge.difficulty) }}</p>
  <p><a href="{{ challenge.url }}">{{ t("refresh.continue") }}</a></p>
  {% if honeypot_url %}<a href="{{ honeypot_url }}" rel="nofollow" hidden aria-hidden="true" tabindex="-1"></a>{% endif %}
</main>
{% endblock %}
